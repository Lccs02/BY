# Required (compatible aliases: APP_ID/LARK_APP_ID and APP_SECRET/LARK_APP_SECRET)
FEISHU_APP_ID=cli_your_app_id
FEISHU_APP_SECRET=your_app_secret

# Optional: existing Bitable URL or app token. If both are absent, --apply can create one.
# FEISHU_BITABLE_URL=https://example.feishu.cn/base/bascnxxxxxxxx
# FEISHU_APP_TOKEN=bascnxxxxxxxx

# Optional; defaults to Asia/Shanghai and is set explicitly in GitHub Actions.
# BUSINESS_TIMEZONE=Asia/Shanghai
